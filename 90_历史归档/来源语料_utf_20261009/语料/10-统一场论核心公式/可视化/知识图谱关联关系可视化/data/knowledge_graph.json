  "nodes": [
    {
      "id": "spacetime_unification",
      "name": "时空同一化方程",
      "category": "时空基础",
      "formula": "\\vec{r}(t) = \\vec{C}t = x\\vec{i} + y\\vec{j} + z\\vec{k}",
      "description": "描述时空本质统一的数学表达",
      "importance": 10,
      "level": 1,
      "color": "#6366f1",
      "size": 30
    },
    {
      "id": "spiral_spacetime",
      "name": "三维螺旋时空方程",
      "category": "时空基础",
      "formula": "\\vec{r}(\\theta) = a\\theta\\cos(\\theta)\\vec{i} + a\\theta\\sin(\\theta)\\vec{j} + b\\theta\\vec{k}",
      "description": "空间螺旋运动的数学模型",
      "importance": 9,
      "level": 1,
      "color": "#8b5cf6",
      "size": 28
    },
    {
