g_log = LoggerInit.init(__name__)


def ensure_dir(path):
    """确保目录存在：不存在则创建，已存在则跳过，同名文件则删除后重建"""
    p = Path(path)
    if p.exists() and p.is_file():
        p.unlink()
    p.mkdir(parents=True, exist_ok=True)
    return p


class MinimalRPAFlow(BaseFlow):
    """极简RPA流程类 - 使用aibot_common"""

    def __init__(self, config_manager=None, **kwargs):
        super().__init__(config_manager=config_manager, **kwargs)
        # 使用预导入的BROWSER_RPA实例
        self.browser_rpa = BROWSER_RPA
        self.button_rpa = BUTTON_RPA
        self.page_rpa = PAGE_RPA
        self.mouse_rpa = MOUSE_RPA
        self.config_manager = config_manager
        self.other_rpa = OTHER_RPA
        self.get_data_rpa = GETDATA_RPA
        self.g_dict = {}

    def start_data(self, table_id, auth_code):  # 初始化异常数据
        g_log.info("--------------数据初始化")
        payload = {
            "uniId": table_id,
            "pageSize": 1,
            "reqParam": {
                "queryParam": [
                    {
                        "field": "zt",
                        "value": [
                            "处理中"
                        ],
                        "sign": "=",
                        "append": "or"
                    }, {
                        "field": "zt",
                        "value": [
                            "异常"
                        ],
                        "sign": "=",
                        "append": "or"
                    }
                ],
                "updateMap": {
                    "zt": "",

                }
            }
        }
        while True:
            rqs_data = self.other_rpa.post_request(
                url="http://146.24.58.227:88/ymkj-api/uni/universal/pull",
                payload=payload,
                auth_token=f'AuthCode {auth_code}')
            g_log.info(f"API响应数据: {rqs_data}")
            data = rqs_data['data']['list']
            if len(data) == 0:  # 判断是否还有数据需要操作
                g_log.info("数据初始化完成，没有更多数据")
                break



    def extract_current_page_date(self):
        #提取案号并写入Excel
        #获取表格数据
        try:
            # 使用XPATH定位目标div
            target_div_xpath = "/html/body/div/div[7]"

            WebDriverWait(self.driver1,10).until(
                EC.presence_of_element_located((By.XPATH,target_div_xpath))
            )
            target_div = self.driver1.find_element(By.XPATH,target_div_xpath)
            #在div内找table
            table = target_div.find_element(By.TAG_NAME,"table")
            tbody = table.find_element(By.TAG_NAME,"tbody")
            rows = tbody.find_elements(By.TAG_NAME,"tr")
            if len(rows) == 0:
                g_log.info("没有找到文书")
                return None
            g_log.info(f"找到{len(rows)}个文书")
            page_data = []
            for index,row in enumerate(rows):
                cells = row.find_elements(By.TAG_NAME,"td")
                if len(cells) >=2:
                    case_number = cells[1].text.strip()
                    g_log.info(f"第{index+1}行")
            g_log.info(f"成功提取{len(page_data)}条数据")
            return page_data
        except Exception as e:
            g_log.error(f"提取数据失败：{e}")
            return None


