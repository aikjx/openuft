# ================================ 全局变量初始化 ================================
g_log = LoggerInit.init(__name__)




def ensure_dir(path):
    """确保目录存在；不存在则创建（含父目录），返回原路径。"""
    if path:
        os.makedirs(path, exist_ok=True)
    return path


def _flow_root():
    """流程运行根目录：AIBOT_LINUX_ROOT 优先，其次当前工作目录（不再默认 C 盘）。"""
    return os.environ.get("AIBOT_LINUX_ROOT", os.getcwd())


class MinimalRPAFlow(BaseFlow):
    """极简RPA流程类 - 使用aibot_common"""

    def __init__(self, config_manager=None, **kwargs):
        super().__init__(config_manager=config_manager, **kwargs)
        # 使用预导入的BROWSER_RPA实例
        self.browser_rpa = BROWSER_RPA
        self.button_rpa = BUTTON_RPA
        self.page_rpa = PAGE_RPA
        self.mouse_rpa = MOUSE_RPA
        self.config_manager = config_manager
        self.other_rpa = OTHER_RPA
        self.get_data_rpa = GETDATA_RPA
        self.g_dict = {}

    def start_data(self, table_id, auth_code):  # 初始化异常数据
        g_log.info("--------------数据初始化")
        payload = {
            "uniId": table_id,
            "pageSize": 1,
            "reqParam": {
                "queryParam": [
                    {
                        "field": "zt",
                        "value": [
                            "处理中"
                        ],
                        "sign": "=",
                        "append": "or"
                    }, {
                        "field": "zt",
                        "value": [
                            "异常"
                        ],
                        "sign": "=",
                        "append": "or"
                    }
                ],
                "updateMap": {
                    "zt": "",

                }
            }
        }
        while True:
            rqs_data = self.other_rpa.post_request(
                url="http://146.24.58.227:88/ymkj-api/uni/universal/pull",
                payload=payload,
                auth_token=f'AuthCode {auth_code}')
            g_log.info(rqs_data)
            data = rqs_data['data']['list']
            if len(data) == 0:  # 判断是否还有数据需要操作
                break

    def extract_all_pages_case_numbers(self,excel_path):
        """提取所有页面的案号并写入excel"""
        # 1、读取已存在的案号（如果文件存在）
        existing_application_nos = set()
        if os.path.exists(excel_path):
            try:
                existing_df = pd.read_excel(excel_path)
                if '申请单号' in existing_df.columns:
                    existing_application_nos = set(existing_df['申请单号'].astype(str).str.strip())
                    g_log.info(f"已存在的申请单号数量：{len(existing_application_nos)}")
            except Exception as e:
                g_log.info(f"读取现有excel失败:{e}")

        final_new_data = []
        page_num = 1
        while True:
            g_log.info(f"\n{'='*50}")
            g_log.info(f"正在处理第{page_num}页")
            g_log.info(f"{'='*50}")

            try:
                #等待当前页面的数据
                time.sleep(2)
                #获取当前页面的数据
                page_data = self.extract_current_page_data()
                if not page_data:
                    g_log.info("本页无数据，结束")
                    break

                g_log.info(f"本页原始数据：{len(page_data)}条")
                new_in_page = 0

                for item in page_data:
                    application_no = item['申请单号'].strip()
                    if application_no  in existing_application_nos:
                        g_log.info(f"跳过重复申请单号：{application_no}")
                        continue

                    #真正新增
                    g_log.info(f"新增，加入列表:{application_no}")
                    final_new_data.append(item)
                    existing_application_nos.add(application_no)  # 添加到集合，避免本页内重复
                    new_in_page +=1
                g_log.info(f"本页新增：{new_in_page}条,累计新增:{len(final_new_data)}条")

                # 本页全部重复且非第一页，说明已到最后或循环回开头
                if new_in_page == 0 and page_num > 1:
                    g_log.info("本页全部重复，已达数据末尾，结束翻页")
                    break

                if not self.go_to_next_page():
                    g_log.info("没有下一页")
                    break
                page_num += 1

            except Exception as e:
                g_log.info(f"处理第{page_num}页面出错:{e}")
                continue
        #保存只保存新的数据
        if final_new_data:
            g_log.info(f"最终all_data = {len(final_new_data)}")

            self.save_to_excel(final_new_data,excel_path)
            g_log.info(f"\n总计提取{len(final_new_data)}条案号，已保存到：{excel_path}")
            return final_new_data
        else:
            g_log.info("没有新增数据")
        return final_new_data

    def extract_current_page_data(self):
        #提取案号并写入Excel
        #获取表格数据
        tbody = self.driver.find_element(By.TAG_NAME,"tbody")
        # if not forms:
        #     g_log.info("未找到表单")
        #     return None
        # first_form = forms[0]
        #获取表格
        # table = first_form.find_element(By.XPATH,"//*[@id='pane-/czcl']/div/div[1]/div[6]/div[3]/table")
        #获取tbody
        # tbody = table.find_element(By.XPATH,"//*[@id='pane-/czcl']/div/div[1]/div[6]/div[3]/table/tbody")
        #获取tbody中所有的行（tr）
        rows = tbody.find_elements(By.TAG_NAME,"tr")
        g_log.info(f"找到{len(rows)}行数据")
        if len(rows) == 0:
            g_log.info("tbody中没有数据行")
            return None

        #存储所有案号数据
        page_data = []
        #遍历每一行
        for index,row in enumerate(rows):
            #获取第一行
            # first_row = rows[0]
            cells = row.find_elements(By.TAG_NAME,"td")
            if len(cells) >= 2:
                #提取案号（第一列）
                case_number = cells[1].text.strip()
                application_no = cells[24].text.strip()
                g_log.info(f"提取到的案号：{case_number},申请单号：{application_no}")

                if application_no:
                    g_log.info(f"第{index+1}行 - 申请单号:{application_no},案号:{case_number}")
                    #写入excel
                    page_data.append({
                        "案号": case_number,
                        "申请单号": application_no,
                        "状态":""
                    })
                else:
                    g_log.info(f"第{index+1}行申请单号为空，跳过")
            else:
                g_log.info(f"第{index+1}行列数不足，跳过")
        return page_data

    def go_to_next_page(self):
        """翻到下一页"""
        try:
            # Element UI 分页：查找下一页箭头按钮
            next_btn = self.driver.find_element(By.XPATH, '//button[contains(@class,"btn-next")]')
            # 检查是否禁用（最后一页）
            disabled = next_btn.get_attribute('disabled')
            if disabled:
                g_log.info("已到最后一页，翻页按钮已禁用")
                return False
            #滚动到按钮位置
            self.driver.execute_script("arguments[0].scrollIntoView()", next_btn)
            time.sleep(1)
            #点击下一页
            next_btn.click()
            g_log.info("已点击下一页")


            #等待页面加载完成（等待表格刷新）
            time.sleep(3)

            return True
        except Exception as e:
            # 降级：尝试箭头图标
            try:
                next_icon = self.driver.find_element(By.XPATH, '//i[contains(@class,"el-icon-arrow-right")]')
                parent_btn = next_icon.find_element(By.XPATH, '..')
                if parent_btn.get_attribute('disabled'):
                    g_log.info("已到最后一页")
                    return False
                self.driver.execute_script("arguments[0].scrollIntoView()", next_icon)
                time.sleep(1)
                next_icon.click()
                g_log.info("已点击下一页")
                time.sleep(3)
                return True
            except Exception as e2:
                g_log.info(f"翻页失败:{e2}")
                return False

    def save_to_excel(self,data,excel_path):
        """保存数据到Excel"""
        try:
            if len(data)==0:
                g_log.info("没有数据需要保存")
                return
            g_log.info(f"数据条数：{len(data)}")
            g_log.info(f"保存路径：{excel_path}")

            df = pd.DataFrame(data)
            #添加序号列
            df.insert(0,"序号",range(1,len(df)+1))
            #检查文件是否存在
            if os.path.exists(excel_path):
                #文件存在，追加数据
                existing_df = pd.read_excel(excel_path)
                combined_df = pd.concat([existing_df,df],ignore_index=True)
                combined_df.to_excel(excel_path,index=False)
                g_log.info(f"追加{len(data)}条数据到现有文件")
            else:
                #文件不存在，创建新文件
                df.to_excel(excel_path,index=False)
                g_log.info(f"创建新文件，写入{len(data)}条数据")
            g_log.info(f"数据已保存到:{excel_path}")

        except Exception as e:
            g_log.info(f"保存Excel出错:{e}")
            import traceback
            traceback.print_exc()
    def read_cases_from_excel(self,excel_path,case_column='案号',app_column='申请单号',status_column='状态'):
        """
        :param excel_path:Excel文件路径
        :param column_name: 案号所在的列名
        :return: 案号列表
        """
        try:
            df = pd.read_excel(excel_path)
            if case_column not in df.columns:
                g_log.info(f"错误：找不到列'{case_column}'")
                g_log.info(f"可用列：{list(df.columns)}")
                return None
            result = []
            for index,row in df.iterrows():
                case_num = str(row[case_column]).strip() if pd.notna(row[case_column]) else ""
                app_num = str(row[app_column]).strip() if app_column in df.columns and pd.notna(row[app_column]) else ""
                status = ""
                if status_column in df.columns and pd.notna(row[status_column]):
                    status = str(row[status_column]).strip()

                if app_num:
                    result.append({
                        '案号':case_num,
                        '申请单号':app_num,
                        '状态': status,
                        '行号': index + 2
                    })

            g_log.info(f"从Excel读取到{len(result)}个案号")
            return result
        except Exception as e:
            g_log.info(f"读取失败: {e}")
            return None
    def update_status_to_excel(self,excel_path,application_no,status="已完成",app_column='申请单号',status_column='状态',row_number=None):
        try:
            df = pd.read_excel(excel_path)
            if status_column not in df.columns:
                df[status_column] = ''

            if row_number is not None and row_number > 1:
                target_index = row_number - 2
                if target_index >= 0 and target_index < len(df):
                    df.iloc[target_index, df.columns.get_loc(status_column)] = status
                    g_log.info(f"已更新第{row_number}行的状态为:{status}")
                else:
                    g_log.info(f"行号{row_number}超出范围，文件共有{len(df)}行数据")
                    return
            else:
                g_log.info(f"未提供行号，无法精确更新状态，申请单号:{application_no}")
                return

            df.to_excel(excel_path,index=False)
        except Exception as e:
            g_log.info(f"更新状态失败:{e}")
            import traceback
            traceback.print_exc()

    def find_rows_with_retry(self, rows_xpath, query_button_xpath, max_retries=3, retry_delay=2):
        """查询结果短暂未刷新时重试，避免把未加载的数据误判为无数据。"""
        rows = []
        for retry_index in range(max_retries):
            wait = WebDriverWait(self.driver,5)
            # rows = self.driver.find_elements(By.XPATH, rows_xpath)
            rows = wait.until(EC.presence_of_all_elements_located((By.XPATH,rows_xpath)))
            if len(rows) > 0:
                return rows
            # if retry_index < max_retries - 1:
            #     g_log.info(f"第{retry_index + 1}次查询未找到数据，重试中...")
            #     time.sleep(retry_delay)
            #     try:
            #         self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH, value=query_button_xpath)
            #     except Exception as e:
            #         g_log.info(f"重试点击查询失败: {e}")
            #     time.sleep(1.5)
        return rows

    def handle_modal_dialog(self,modal_selector):
        """处理模态框弹窗"""
        try:
            #等待模态框出现
            modal = WebDriverWait(self.driver,10).until(
                EC.presence_of_element_located((By.CSS_SELECTOR,modal_selector))
            )
            g_log.info("模态框已出现")

            #查找所有按钮
            buttons = modal.find_elements(By.TAG_NAME,"button")
            #点击包含打印文本的按钮
            for button in buttons:
                if "打印" in button.text:
                    button.click()
                    g_log.info("已点击打印按钮")
                    return True
            #如果没有找到打印按钮，点击第一个按钮
            if buttons:
                buttons[0].click()
                g_log.info("已点击第一个按钮")
                return True
            return False

        except Exception as e:
            g_log.info(f"处理模态框失败:{e}")
            return  False

