                                                        text="已完成集中查控")
                        time.sleep(2)
                        #点击集中查控结束-----------------------------
                        self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                        value="//*[@id='app']/div/div/div[2]/button[1]")
                        time.sleep(2)
                        # 点击提示
                        self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                         value="/html/body/div[18]/div/div[3]/button[2]/span")
                        time.sleep(4)
                        # 等待繁简甄别弹窗出现
                        try:
                            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH,
                                                    value='//*[@id="app"]/div[2]/div/div[1]/span')
                            #点击保存
                            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                         value="//*[@id='app']/div[2]/div/div[3]/span/button[2]")
                        except:
                            #可能会出现没有弹窗但是已经完成的情况
                            # 回填状态---
                            df.at[index, '状态'] = '已完成'
                            time.sleep(2)
                            df.to_excel(excel_file, index=False)
                            # 退出iframe，回到主页面
                            self.driver.close()
                            self.driver.switch_to.window(self.driver.window_handles[0])
                            continue
                        #回填状态---
                        df.at[index, '状态'] = '已完成'
                        time.sleep(2)
                        df.to_excel(excel_file, index=False)
                        #退出iframe，回到主页面
                        self.driver.close()
                        self.driver.switch_to.window(self.driver.window_handles[0])
                    except Exception as e:
                        g_log.error(f"处理案号失败：{an_hao}, 错误：{e}")
                        self.g_dict["err"] = True
                        return False

        except Exception as e:
            self.g_dict["err"] = True
            g_log.error(f"业务初始化异常：{e}")
            g_log.exception("业务初始化异常详细信息")

    def yw_cl(self):
        try:
            # 开始循环写入数据

            time.sleep(3.5)
        except Exception as e:
            self.g_dict["err"] = True
            g_log.error(f"业务处理异常：{e}")
            g_log.exception("业务处理异常详细信息")

    def click_js(self, xpath):
        click_el = xpath
        click = f'''
            var el = document.evaluate("{click_el}",document,null,
            XPathResult.FIRST_ORDERED_NODE_TYPE,
            null).singleNodeValue;
            if(el) el.click();
        '''
        self.driver.execute_script(click)

    def input_js(self, xpath, input_text):
        input_el = xpath
        text = input_text
        ipt = f'''
            var el = document.evaluate("{input_el}",document,null,
            XPathResult.FIRST_ORDERED_NODE_TYPE,
            null).singleNodeValue;
            if(el){{
                el.value = '{text}';
                el.dispatchEvent(new Event('input'));
                el.dispatchEvent(new Event('change'));
            }}
        '''
        self.driver.execute_script(ipt)
    def wait_js(self,xpath):
        wait_el = xpath
        wait = f'''
            var el = document.evaluate("{wait_el}",document,null,
            XPathResult.FIRST_ORDERED_NODE_TYPE,
            null).singleNodeValue;
            return el;
        '''
        self.driver.execute_script(wait)
    def run_business(self):
        """实现具体的业务逻辑 - 完全使用aibot_common的浏览器操作组件"""
        try:
            g_log.info("开始执行业务逻辑...")
            g_log.info("重试次数：%d", get_retry_count())
            g_log.info("业务逻辑执行中----")
            self.g_dict["err"] = False
            
            g_log.info("---------------初始化开始")
            self.csh()
            g_log.info("---------------初始化结束")
            
            g_log.info("---------------浏览器初始化开始")
            if not self.driver:
                if not self.init_browser():
                    g_log.error("浏览器初始化失败，无法继续执行")
                    return False
            g_log.info("---------------浏览器初始化结束")
            
            g_log.info("---------------业务初始化开始")
            yw_result = self.yw_csh()
            if yw_result is False:
                g_log.error("业务初始化返回失败，标记异常")
                self.g_dict["err"] = True
            g_log.info("---------------业务初始化结束")
            
            g_log.info("---------------业务处理开始")
            self.yw_cl()
            g_log.info("---------------业务处理结束")
            
            time.sleep(1)
            self.logger.info("流程执行完毕")
            
            if self.g_dict["err"]:
                raise Exception("存在异常，进入重试")

            g_log.info("业务逻辑执行完成")

            return True
        except Exception as e:
            g_log.exception(f"业务逻辑执行异常: {e}")
            return False
        finally:
            try:
                if hasattr(self, 'video_recorder') and self.video_recorder:
                    g_log.info("清理视频录制器资源...")
                    self.video_recorder.stop_recording()
                    g_log.info("视频录制器资源清理完成")
            except Exception as cleanup_e:
                g_log.warning(f"清理视频录制器时出错: {cleanup_e}")
            try:
                shutil.rmtree(self.g_dict["ls_dir"])
            except Exception as e:
                pass


def main():
    """主函数"""
    from aibot_rpa.config.manager import ConfigManager

    exit_code = 0
    flow = None

    try:
        g_log.info("=== 程序启动 ===")

        # 1. 初始化配置管理器
        config_manager = ConfigManager()

        # 2. 加载配置
        config_template = {
            "taskId": "minimal_demo_001",
            "name": "E键材料下载上传",
