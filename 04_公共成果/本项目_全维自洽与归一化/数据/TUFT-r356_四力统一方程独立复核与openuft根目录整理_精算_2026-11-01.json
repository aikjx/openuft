   "layer": "语料",
   "text": "r214 JSON 机读：条目 31（PASS 18 / BOUNDARY 5 / INFO 5 / FAIL 3）；母式 F=-s·α·ħc/r²·e^{-r/λ}(1+r/λ)·r̂",
   "verdict": "PASS",
   "note": ""
  },
  {
   "id": "R2",
   "layer": "参数",
   "text": "λ_W 复算 2.4550179820E-18 m（r214 2.4550179820E-18，相对差 0）；λ_π 复算 1.4619325717E-15 m（1.4619325717E-15，0）",
   "verdict": "PASS",
   "note": "λ = ħc/(m c²)，回代 m_W=80.377 GeV / m_π0=134.9768 MeV"
  },
  {
   "id": "R3",
   "layer": "参数",
   "text": "α_W = G_F·m_p² 复算 1.02682675E-5（r214 1.02682675E-5）；α_G(pp) = G·m_p²/ħc 复算 5.90614942E-39（5.90614942E-39）",
   "verdict": "PASS",
   "note": ""
  },
  {
   "id": "R4",
   "layer": "力比",
   "text": "α_em/α_G(pp) = 1.235552E+36（r214 1.235552E+36，相对差 2.2198E-12）⇒ 两质子间电磁比引力强 10^36 量级",
   "verdict": "INFO",
   "note": "该比值与 r214 差 2.2E-12：量级相当于 α_em 常数在第 12 位的口径差，本卷不猜来源"
  },
  {
   "id": "R5",
   "layer": "大小表",
   "text": "四尺度 × 四力 = 16 格：一致 16 格。G/W/S 十二格 rel=0；EM 四格恒差 2.2E-12（同一 α_em 常数口径差）；underflow 六格按「不可分辨」判定（log10<-70）",
   "verdict": "PASS",
   "note": "口径：α_G(pp)、α_em、α_W=G_F·m_p²、α_π=g²/4π=14.6"
  },
  {
   "id": "R6",
   "layer": "大小表",
   "text": "1 fm 四力（N）：G 1.8672E-34 / EM 230.7078 / W 1.6660E-175 / S 392220.0415",
   "verdict": "INFO",
   "note": "两质子基准：弱与强在 1 fm 已差约 180 个量级"
  },
  {
   "id": "R7",
   "layer": "距离",
   "text": "r⁻² 标度：G 与 EM 在 1 fm→1 Å 的比值 = 1.000000E+10 / 1.000000E+10（应 1E10）",
   "verdict": "PASS",
   "note": "λ=∞ 分支严格 1/r²；短程支由 e^{-x}(1+x) 压低（x=r/λ）"
  },
  {
   "id": "R8",
   "layer": "求导",
   "text": "F = −dU/dr：20 组 (λ, r) 的解析 vs 四阶 Richardson 数值微分，最大相对残差 1.357923E-30；dU/dr 在 20 组上恒正（吸引）",
   "verdict": "PASS",
   "note": "残差非 0 ⇒ 不是恒等复读；阈值 1e-28（步长 r·1e-8 的四阶截断 ~1e-32）"
