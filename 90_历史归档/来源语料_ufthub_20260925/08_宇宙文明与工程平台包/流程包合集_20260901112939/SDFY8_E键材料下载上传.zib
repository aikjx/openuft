    def yw_cl(self):
        """业务处理"""
        try:
            time.sleep(3.5)
        except Exception as e:
            self.g_dict["err"] = True
            g_log.error(f"业务处理异常: {e}")
            traceback.print_exc()

    def run_business(self):
        """执行业务逻辑"""
        try:
            g_log.info("开始执行业务逻辑...")
            g_log.info("重试次数：%d", get_retry_count())

            self.g_dict["err"] = False

            g_log.info("---------------初始化开始")
            self.csh()
            g_log.info("---------------初始化结束")

            g_log.info("---------------业务初始化开始")
            self.yw_csh()
            g_log.info("---------------业务初始化结束")

            g_log.info("---------------业务处理开始")
            self.yw_cl()
            g_log.info("---------------业务处理结束")

            time.sleep(1)
            self.logger.info("流程执行完毕")

            if self.g_dict["err"]:
                raise Exception("存在异常，进入重试")

            g_log.info("业务逻辑执行完成")
            return True

        except Exception as e:
            g_log.exception(f"业务逻辑执行异常: {e}")
            return False
        finally:
            try:
                g_log.info("使用self.browser_rpa关闭浏览器...")
                try:
                    if "ls_dir" in self.g_dict:
                        shutil.rmtree(self.g_dict["ls_dir"], ignore_errors=True)
                except Exception:
                    pass
                self.browser_rpa.close_browser()
            except Exception as e:
                g_log.warning(f"关闭浏览器时出错: {e}")
                self.driver_quit()


def main():
    """主函数"""
    from aibot_rpa.config.manager import ConfigManager

    exit_code = 0
    flow = None

    try:
        g_log.info("=== 程序启动 ===")

        config_manager = ConfigManager()

        config_template = {
            "taskId": "minimal_demo_001",
            "name": "E键材料下载上传",
            "executable_path": "D:/module/driver/86/chromedriver.exe",
            "browser_path": "D:/app/360Chrome/Chrome/Application/360chrome.exe",
            "max_retries": 2,
            "retry_delay": 2,
            "timeout": 30,
            "record_video": True,
            "live_push": True,
            "headless": False,
            "start_time": "2025-11-20",
            "AuthCode": "2TR5gFSPA3DCbj374poHt",
            "loginPW": r"CYJun*123",
            "loginAcc": r"18000850505",
            "isPW": None,
            "end_time": "2025-11-25",
            "uniTable": [["rlXGyHEa17kZIaVg1wUgw", "总对总查询"]],
            "保存路径": "D:/module/driver/86"
        }

        s = config_template["loginPW"]
        if s.startswith('0') and s.isdigit():
            config_template['isPW'] = True

        config_manager.load_config_args(config_template)
        g_log.info(f"配置加载完成: {config_manager.get_config('name', 'Unknown')}")

        g_log.info("开始执行RPA流程...")
        flow = MinimalRPAFlow(config_manager=config_manager)
        result = flow.execute()

        if result:
            g_log.info("✅ RPA流程执行成功！")
            g_log.info({"msg": "已完成"})
            exit_code = 0
        else:
            g_log.error("❌ RPA流程执行失败！")
            g_log.info({"error": "运行异常"})
            exit_code = 1

    except KeyboardInterrupt:
        g_log.warning("⚠️ 用户中断程序执行")
        exit_code = 2

    except Exception as e:
        g_log.exception(f"💥 程序执行异常: {e}")
        exit_code = 1

    finally:
        try:
            if flow and hasattr(flow, 'driver') and flow.driver:
                flow.driver_quit()
                g_log.info("一张网系统浏览器已关闭")
            if flow and hasattr(flow, 'driver1') and flow.driver1:
                flow.driver_quit(flow.driver1)
                g_log.info("E键达系统浏览器已关闭")
        except Exception as e:
            g_log.warning(f"关闭浏览器时出错: {e}")
        g_log.info("=== 程序结束 ===")

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
