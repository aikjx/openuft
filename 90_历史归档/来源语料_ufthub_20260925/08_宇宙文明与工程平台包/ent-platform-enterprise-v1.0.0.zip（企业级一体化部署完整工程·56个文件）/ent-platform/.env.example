# =============================================================================
# 环境变量样板 —— 复制为 .env 后由 install 脚本自动生成强密码
# 所有端口/密码/版本/调优参数集中在此, 改这一个文件即可, 不要改 compose
# 字段顺序与 docs/05-配置详解.md 一一对应
# =============================================================================

# ---------- 全局 ----------
TZ=Asia/Shanghai
# 平台架构由脚本自动探测; 也可手动覆盖: amd64 | arm64
# DOCKER_DEFAULT_PLATFORM=linux/amd64

# ---------- 端口规划 (宿主机侧; 中间件默认只绑 127.0.0.1) ----------
HTTP_PORT=80                 # Nginx 对外 HTTP
# HTTPS_PORT=443
MYSQL_PORT=3306              # 仅 127.0.0.1 暴露
REDIS_PORT=6379              # 仅 127.0.0.1 暴露

# ---------- 数据库账号密码 (install 脚本会把 CHANGE_ME 替换为随机强密码) ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=CHANGE_ME_STRONG

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_STRONG
TASK_QUEUE=rpa:tasks         # Worker 任务队列 (Redis List)
RESULT_QUEUE=rpa:results     # 结果回写队列

# ---------- 镜像版本 (生产固定版本, 禁止 latest) ----------
MYSQL_TAG=8.0
REDIS_TAG=7.2
NGINX_TAG=1.27
PYTHON_TAG=3.10-slim
PLAYWRIGHT_TAG=v1.48.0-jammy
BACKEND_VERSION=latest
WORKER_VERSION=latest

# ---------- Java 后端 ----------
SPRING_PROFILES=prod
# 容器内 JVM 堆; 按机器内存调: 2G机器-Xmx768m, 4G-Xmx2g, 8G-Xmx4g
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Duser.timezone=Asia/Shanghai

# ---------- OCR ----------
# x86_64 默认 paddle(飞桨); arm64/信创 默认 rapid(ONNX, 跨架构稳定)
OCR_ENGINE=paddle
OCR_LANG=ch
OCR_WORKERS=1                # PaddleOCR 单实例非线程安全, 高并发靠水平扩容

# ---------- 自动化 Worker ----------
WORKER_CONCURRENCY=2         # 单 Worker 容器内并发页面数, CPU 核少建议 1~2
PAGE_TIMEOUT=60000
# 出口 IP 代理 (IP任务用; 留空直连)
HTTP_PROXY=
HTTPS_PROXY=

# ---------- 资源上限 (compose 支持的简单限额; 详见 docs/05) ----------
MYSQL_MEM_LIMIT=2g
REDIS_MEM_LIMIT=1g
OCR_MEM_LIMIT=2g
BROWSER_MEM_LIMIT=1g
