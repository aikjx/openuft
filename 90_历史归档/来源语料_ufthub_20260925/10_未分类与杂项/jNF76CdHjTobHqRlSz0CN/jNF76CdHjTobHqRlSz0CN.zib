    def _clean_extra_tabs(self, keep=2):
        """清理多余tab，只保留前keep个窗口（默认：列表页+详情页）。"""
        try:
            handles = self.driver.window_handles
            if len(handles) > keep:
                g_log.info(f"检测到多余tab，当前{len(handles)}个，保留前{keep}个")
                for h in handles[keep:]:
                    try:
                        self.driver.switch_to.window(h)
                        self.driver.close()
                    except Exception:
                        pass
                self.driver.switch_to.window(handles[keep - 1])
                g_log.info(f"已清理，剩余{len(self.driver.window_handles)}个窗口")
        except Exception as e:
            g_log.info(f"清理tab失败: {e}")

    def _safe_close_tab(self):
        """安全关闭当前tab：先ESC关闭可能的原生弹窗/alert，再close。"""
        try:
            # 尝试关闭alert
            try:
                alert = self.driver.switch_to.alert
                alert.dismiss()
                time.sleep(0.3)
            except Exception:
                pass
            # ESC关闭可能存在的原生打印对话框
            try:
                self.driver.switch_to.active_element.send_keys(Keys.ESCAPE)
                time.sleep(0.3)
            except Exception:
                pass
            self.driver.close()
        except Exception as e:
            g_log.info(f"close tab异常(可能是原生弹窗阻塞): {e}")
            # 最后尝试：再ESC一次
            try:
                self.driver.switch_to.active_element.send_keys(Keys.ESCAPE)
                time.sleep(0.5)
                self.driver.close()
            except Exception:
                pass

    def handle_print_and_close_preview(self):
        """处理打印并关闭打印预览页"""
        try:
            #记录当前所有窗口
            all_windows = self.driver.window_handles
            g_log.info(f"当前窗口数量：{len(all_windows)}")

            if len(all_windows) < 3:
                g_log.info(f"窗口不足3个，无法关闭预览页，尝试切回详情页")
                if len(all_windows) > 1:
                    self.driver.switch_to.window(all_windows[1])
                return True

            preview_window = all_windows[2]
            detail_window = all_windows[1]

            #确保在打印预览页
            self.driver.switch_to.window(preview_window)
            g_log.info("已切换到打印预览页")
            time.sleep(2)
            self.driver.close()
            g_log.info("已关闭打印预览页")
            self.driver.switch_to.window(detail_window)
            g_log.info("已返回详情页")

            return True
        except Exception as e:
            g_log.info(f"处理失败：{e}")
            return False

