class MinimalRPAFlow(BaseFlow):
    """E键材料下载上传流程类"""

    def __init__(self, config_manager=None, **kwargs):
        super().__init__(config_manager=config_manager, **kwargs)
        self.browser_rpa = BROWSER_RPA
        self.button_rpa = BUTTON_RPA
        self.page_rpa = PAGE_RPA
        self.mouse_rpa = MOUSE_RPA
        self.config_manager = config_manager
        self.other_rpa = OTHER_RPA
        self.get_data_rpa = GETDATA_RPA
        self.g_dict = {}
        self.driver1 = None
        self.driver = None

    def _extract_case_numbers(self, an_hao):
        """从案号中提取数字"""
        numbers = re.findall(r'\d+', an_hao)
        g_log.info(f"案号：{an_hao}, 提取的数字：{numbers}")
        return numbers

    def _resolve_driver(self, driver=None):
        """获取当前可用浏览器，兼容下载端driver1和上传端driver。"""
        if driver is not None:
            return driver
        driver = getattr(self.page_rpa, "driver", None)
        if driver is not None:
            return driver
        if self.driver is not None:
            return self.driver
        if self.driver1 is not None:
            return self.driver1
        raise RuntimeError("浏览器driver未初始化")

    def click_js(self, xpath):
        click_el = xpath
        click = f'''
              var el = document.evaluate("{click_el}",document,null,
              XPathResult.FIRST_ORDERED_NODE_TYPE,
              null).singleNodeValue;
              if(el) el.click();
          '''
        self.driver.execute_script(click)

    def input_js(self, xpath, input_text):
        input_el = xpath
        text = input_text
        ipt = f'''
              var el = document.evaluate("{input_el}",document,null,
              XPathResult.FIRST_ORDERED_NODE_TYPE,
              null).singleNodeValue;
              if(el){{
                  el.value = '{text}';
                  el.dispatchEvent(new Event('input'));
                  el.dispatchEvent(new Event('change'));
              }}
          '''
        self.driver.execute_script(ipt)

    def wait_js(self, xpath):
        wait_el = xpath
        wait = f'''
              var el = document.evaluate("{wait_el}",document,null,
              XPathResult.FIRST_ORDERED_NODE_TYPE,
              null).singleNodeValue;
              return el;
          '''
        self.driver.execute_script(wait)

    def csh(self):
        """初始化配置"""
        try:
            config_dict = self.config_manager.get_dict_config()
            self.g_dict["config_dict"] = config_dict

            self.g_dict["auth_code"] = config_dict["AuthCode"]
            self.g_dict["login_acc"] = str(config_dict["loginAcc"])

            if config_dict["isPW"]:
                self.g_dict["login_pw"] = "0" + str(config_dict["loginPW"])
            else:
                self.g_dict["login_pw"] = str(config_dict["loginPW"])

            self.g_dict["start_time"] = config_dict["start_time"]
            self.g_dict["end_time"] = config_dict["end_time"]

            self.g_dict["save_dir"] = config_dict["保存路径"]
            if not os.path.isdir(self.g_dict["save_dir"]):
                os.makedirs(self.g_dict["save_dir"])

            if self.g_dict["start_time"] == "" and self.g_dict["end_time"] == "":
                new_data = datetime.datetime.now() - datetime.timedelta(days=1)
                self.g_dict["start_time"] = new_data.strftime("%Y-%m-%d")
                self.g_dict["end_time"] = self.g_dict["start_time"]
            else:
                if self.g_dict["start_time"] == "":
                    self.g_dict["start_time"] = self.g_dict["end_time"]
                elif self.g_dict["end_time"] == "":
                    self.g_dict["end_time"] = self.g_dict["start_time"]

            self.g_dict["new_data"] = self.g_dict["start_time"] + "至" + self.g_dict["end_time"]
            self.g_dict["save_path"] = self.g_dict["save_dir"] + r"/总对总查询_" + self.g_dict["new_data"] + ".xlsx"

            ls_id = str(random.randint(1, 1000000))
            self.g_dict["ls_dir"] = "D:/临时下载/" + ls_id
            if not os.path.isdir(self.g_dict["ls_dir"]):
                os.makedirs(self.g_dict["ls_dir"])

        except Exception as e:
            self.g_dict["err"] = True
            g_log.error(f"初始化失败: {e}")
            traceback.print_exc()

