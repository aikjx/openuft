    def copy_to_clipboard(text):
        """使用Windows自带命令复制到剪贴板"""
        #将文本写入剪贴板
        process = subprocess.Popen(['clip'],stdin=subprocess.PIPE,shell=True)
        process.communicate(text.encode('gbk'))
    def handle_modal_dialog(self,modal_selector):
        """处理模态框弹窗"""
        try:
            #等待模态框出现
            modal = WebDriverWait(self.driver,10).until(
                EC.presence_of_element_located((By.CSS_SELECTOR,modal_selector))
            )
            print("模态框已出现")

            #查找所有按钮
            buttons = modal.find_elements(By.TAG_NAME,"button")
            #点击包含打印文本的按钮
            for button in buttons:
                if "打印" in button.text:
                    button.click()
                    print("已点击打印按钮")
                    return True
            #如果没有找到打印按钮，点击第一个按钮
            if buttons:
                buttons[0].click()
                print("已点击第一个按钮")
                return True
            return False

        except Exception as e:
            print(f"处理模态框失败:{e}")
            return  False
    def handle_print_preview(self):
        """处理打印预览窗口(使用键盘操作)"""
        try:
            #获取所有窗口句柄
            all_windows = self.driver1.window_handles

            print(all_windows)
            if len(all_windows) > 1:
               # 切换到新窗口
                self.driver1.switch_to.window(all_windows[1])
                print(f"已切换到打印预览窗口:{self.driver1.title}")
                #在打印预览窗口中按回车
                time.sleep(1)
                for _ in range(5):
                    self.driver1.switch_to.active_element.send_keys(Keys.TAB)
                    time.sleep(1)
                time.sleep(1)
                self.driver1.switch_to.active_element.send_keys(Keys.ENTER)
                time.sleep(1)
                self.driver1.switch_to.active_element.send_keys(Keys.DOWN)
                time.sleep(1)
                self.driver1.switch_to.active_element.send_keys(Keys.ENTER)
                time.sleep(1)
                for _ in range(4):
                    self.driver1.switch_to.active_element.send_keys(Keys.TAB)
                    time.sleep(1)
                self.driver1.switch_to.active_element.send_keys(Keys.ENTER)
                #关闭打印预览窗口，切回主窗口
                time.sleep(1)
                # self.driver1.close()
                # self.driver1.switch_to.window(all_windows[0])
                #print("已关闭打印预览窗口，返回主窗口")
            else:
                #没有新窗口，尝试在当前页面处理
                print("没有检测到新窗口，尝试在当前页面按回车")
                self.driver.switch_to.active_element.send_keys(Keys.ENTER)
        except Exception as e:
            print(f"处理打印预览窗口：{e}")

    def handle_print_and_save(self):
        """处理打印弹窗并保存为PDF"""
        try:
           time.sleep(2)
           actions = ActionChains(self.driver1)
           for _ in range(4):
               actions.send_keys(Keys.TAB).perform()
               time.sleep(1)
           #按enter进入下拉菜单
           actions.send_keys(Keys.ENTER).perform()
           time.sleep(1)

           #按Down选择“另存为PDF”
           actions.send_keys(Keys.DOWN).perform()
           time.sleep(1)
           actions.send_keys(Keys.ENTER).perform()
           time.sleep(1)
           for _ in range(4):
               actions.send_keys(Keys.TAB).perform()
               time.sleep(1)
           #按Enter保存
           actions.send_keys(Keys.ENTER).perform()
           time.sleep(2)

           print("打印文件已保存")

        except Exception as e:
            print(f"处理失败：{e}")
            return False
    def csh(self):
        try:
            # 使用配置字典 读取参数
            config_dict = self.config_manager.get_dict_config()
            self.g_dict["config_dict"] = config_dict
            # logging.info("***********1")
            # logging.info(config_dict)
            # logging.info(config_dict["AuthCode"])
            # logging.info(config_dict["uniTable"])
            self.g_dict["auth_code"] = config_dict["AuthCode"]
            g_log.info(f"AuthCode: {self.g_dict['auth_code']}")
            # self.g_dict["table_id"] = config_dict["uniTable"][0][0]
            # print(self.g_dict["table_id"])
            logging.info(config_dict["loginAcc"])
            # logging.info(config_dict["isPW"])
            self.g_dict["login_acc"] = str(config_dict["loginAcc"])
            # self.g_dict["login_pw"] = "060218"
            if config_dict["isPW"]:
                self.g_dict["login_pw"] = "0"+str(config_dict["loginPW"])
            else:
                self.g_dict["login_pw"] = str(config_dict["loginPW"])
            logging.info(config_dict["loginPW"])

            # self.start_data(self.g_dict["table_id"], self.g_dict["auth_code"]) # 初始化异常数据

            # 使用配置字典 读取参数
            self.g_dict["start_time"] = config_dict["start_time"]
            self.g_dict["end_time"] = config_dict["end_time"]
            logging.info(self.g_dict["start_time"])
            logging.info(self.g_dict["end_time"])
            self.g_dict["save_dir"] = config_dict["保存路径"]
            ensure_dir(self.g_dict["save_dir"])
            if self.g_dict["start_time"] == "" and self.g_dict["end_time"] == "":
                new_data = datetime.datetime.now()
                new_data = datetime.timedelta(days=-1) + new_data
                new_data = new_data.strftime("%Y-%m-%d")
                self.g_dict["start_time"] = new_data
                self.g_dict["end_time"] = new_data
            else:
                if self.g_dict["start_time"] == "":
                    self.g_dict["start_time"] = self.g_dict["end_time"]
                elif self.g_dict["end_time"] == "":
                    self.g_dict["end_time"] = self.g_dict["start_time"]
            self.g_dict["new_data"] = self.g_dict["start_time"] + "至" + self.g_dict["end_time"]
            self.g_dict["save_path"] = self.g_dict["save_dir"] + r"/总对总查询_" + self.g_dict["new_data"] + ".xlsx"
            ls_id = random.randint(1, 1000000)
            ls_id = str(ls_id)
            self.g_dict["ls_dir"] = "D:/临时下载/" + ls_id
            ensure_dir(self.g_dict["ls_dir"])
        except Exception as e:
            self.g_dict["err"] = True
            g_log.error(f"初始化异常：{e}")
            g_log.exception("初始化异常详细信息")
    def extract_data_from_rows(self,rows):
        data = []
        for row in rows:
            cells = row.find_elements(By.TAG_NAME,"td")
            if len(cells) >= 2:
                case_number = cells[1].text.strip()
                data.append({
                    "案号":case_number,
                    "状态":cells[2].text.strip() if len(cells) > 2 else ""
                })
        return data
    def yw_csh(self):
        try:
            # 使用已初始化的浏览器驱动
            if not self.driver:
                g_log.error("浏览器驱动未初始化")
                return False
            
            # self.driver 为 playwright Page 对象，其无 maximize_window 方法
            # 浏览器已通过 --start-maximized 启动参数最大化窗口，故无需再调用
            # self.driver.maximize_window()
            action = ActionChains(driver=self.driver)

            time.sleep(0.5)

