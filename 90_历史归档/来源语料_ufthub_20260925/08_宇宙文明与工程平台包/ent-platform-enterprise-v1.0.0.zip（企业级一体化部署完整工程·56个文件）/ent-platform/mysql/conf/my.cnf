# =============================================================================
# MySQL 8.0 企业级最优默认配置 (容器内挂载到 /etc/mysql/conf.d/my.cnf)
# 定位: 中等规模 OLTP + 自动化任务读写; 数值按 2C4G 基准给默认, 调优见注释
# 内存自适应请运行: bash scripts/tune-memory.sh
# =============================================================================
[mysqld]
# ---------- 基础 ----------
pid-file        = /var/run/mysqld/mysqld.pid
socket          = /var/run/mysqld/mysqld.sock
port            = 3306
default-storage-engine = InnoDB
default-time-zone = '+08:00'
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
init_connect    = 'SET NAMES utf8mb4'
skip-name-resolve           # 跳过 DNS 反查, 加快连接(只能用 IP/主机名授权)
max_connections = 500       # 2C4G 基准; 8G 可到 1000
max_allowed_packet = 64M    # 自动化任务可能写大 JSON/截图元数据
wait_timeout    = 28800
interactive_timeout = 28800

# ---------- 慢查询: 上线后定位慢 SQL ----------
slow_query_log = ON
long_query_time = 2
log_queries_not_using_indexes = OFF
slow_query_log_file = /var/lib/mysql/slow.log

# ---------- InnoDB (核心调优) ----------
innodb_buffer_pool_size = 1G    # 最优值 = 可用内存的 50%~70%; 由 tune-memory.sh 生成
innodb_buffer_pool_instances = 2 # pool>1G 时, 每 instance 约 1G
innodb_log_file_size    = 256M
innodb_redo_log_capacity = 512M
innodb_flush_log_at_trx_commit = 2  # 1=最安全(默认); 2=性能优先, 宕机最多丢 1s, 自动化业务推荐
innodb_flush_method     = O_DIRECT # 避免与操作系统页缓存双重缓冲
innodb_io_capacity      = 2000  # 普通云盘/SSD; NVMe 可调 4000+
innodb_io_capacity_max  = 4000
innodb_file_per_table   = ON
innodb_autoinc_lock_mode = 2

# ---------- 连接/排序缓冲 (按连接分配, 不宜过大) ----------
sort_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 4M
join_buffer_size = 4M
tmp_table_size = 64M
max_heap_table_size = 64M
table_open_cache = 4000
open_files_limit = 65535

# ---------- 二进制日志: 备份/主从需要; 纯单机可设 OFF 提性能 ----------
server-id = 1
log-bin   = mysql-bin
binlog_format = ROW
binlog_expire_logs_seconds = 604800   # 保留 7 天

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
