# 设置默认行为，使用LF作为行尾字符
* text=auto eol=lf
# 特定文件类型的配置
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# 二进制文件不进行文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar binary
*.gz binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
# 特别配置.obsidian目录下的文件
.obsidian/** -text
.obsidian/workspace.json -text
