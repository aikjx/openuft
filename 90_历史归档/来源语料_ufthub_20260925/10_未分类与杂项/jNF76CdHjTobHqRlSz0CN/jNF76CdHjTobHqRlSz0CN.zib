                #     # 切换到新打开的预览tab
                #     self.driver.switch_to.window(self.driver.window_handles[-1])
                #     g_log.info(f"已切换到新预览:{self.driver.title}")
                #     do_once = True
                time.sleep(2)
                # 确认打印
                self.driver.switch_to.active_element.send_keys(Keys.ENTER)
                g_log.info("已确认打印")
                time.sleep(2)
                # 关闭预览，返回详情页
                # self._safe_close_tab()
                # time.sleep(0.5)
                # self.driver.switch_to.window(self.driver.window_handles[1])
                g_log.info("已关闭打印预览，返回详情页")
                return True, do_once

            g_log.info("没有检测到新窗口，尝试在当前页面按回车")
            self.driver.switch_to.active_element.send_keys(Keys.ENTER)
            return True, do_once
        except Exception as e:
            g_log.info(f"处理打印预览窗口失败：{e}")
            return False, do_once

    def csh(self):
        try:
            # 使用配置字典 读取参数
            config_dict = self.config_manager.get_dict_config()
            self.g_dict["config_dict"] = config_dict
            # logging.info("***********1")
            # logging.info(config_dict)
            # logging.info(config_dict["AuthCode"])
            # logging.info(config_dict["uniTable"])
            self.g_dict["auth_code"] = config_dict["AuthCode"]
            g_log.info(self.g_dict["auth_code"])
            # self.g_dict["table_id"] = config_dict["uniTable"][0][0]
            # g_log.info(self.g_dict["table_id"])
            logging.info(config_dict["loginAcc"])
            # logging.info(config_dict["isPW"])
            self.g_dict["login_acc"] = str(config_dict["loginAcc"])
            # self.g_dict["login_pw"] = "060218"
            if config_dict["isPW"]:
                self.g_dict["login_pw"] = "0"+str(config_dict["loginPW"])
            else:
                self.g_dict["login_pw"] = str(config_dict["loginPW"])
            logging.info(config_dict["loginPW"])

            # self.start_data(self.g_dict["table_id"], self.g_dict["auth_code"]) # 初始化异常数据

            # 使用配置字典 读取参数
            self.g_dict["start_time"] = config_dict["start_time"]
            self.g_dict["end_time"] = config_dict["end_time"]
            logging.info(self.g_dict["start_time"])
            logging.info(self.g_dict["end_time"])
            self.g_dict["save_dir"] = os.path.abspath(config_dict["保存路径"])
            if not os.path.isdir(self.g_dict["save_dir"]):
                os.makedirs(self.g_dict["save_dir"])
            if self.g_dict["start_time"] == "" and self.g_dict["end_time"] == "":
                new_data = datetime.datetime.now()
                new_data = datetime.timedelta(days=-1) + new_data
                new_data = new_data.strftime("%Y-%m-%d")
                self.g_dict["start_time"] = new_data
                self.g_dict["end_time"] = new_data
            else:
                if self.g_dict["start_time"] == "":
                    self.g_dict["start_time"] = self.g_dict["end_time"]
                elif self.g_dict["end_time"] == "":
                    self.g_dict["end_time"] = self.g_dict["start_time"]
            self.g_dict["new_data"] = self.g_dict["start_time"] + "至" + self.g_dict["end_time"]
            self.g_dict["save_path"] = self.g_dict["save_dir"] + r"/总对总查询_" + self.g_dict["new_data"] + ".xlsx"
            ls_id = str(random.randint(1, 1000000))
            # 下载临时目录：置于机器人运行根目录 downloads_tmp 下，不再写入 C 盘
            self.g_dict["ls_dir"] = os.path.abspath(os.path.join(_flow_root(), "downloads_tmp", ls_id))
            ensure_dir(self.g_dict["ls_dir"])
            g_log.info("[路径] 下载临时目录: %s", self.g_dict["ls_dir"])
        except Exception as e:
            self.g_dict["err"] = True
            g_log.exception("初始化(csh)异常 [%s]: %s", type(e).__name__, e)
            traceback.print_exc()

    def yw_csh(self):
        try:
            # 打开浏览器 - set driver first
            # 打开系统网址
            # 直接取配置的驱动/浏览器路径（平台下发优先，无则用 D 盘缺省）
            executable_path = self.config_manager.get_config('executable_path')
            browser_path = self.config_manager.get_config('browser_path')
            # 不再把路径迁移/锁死到 C 盘：未下发时使用 D 盘惯例缺省
            if not executable_path:
                executable_path = r"D:/module/driver/86/chromedriver.exe"
            if not browser_path:
                browser_path = r"D:/app/360Chrome/Chrome/Application/360chrome.exe"

            obj_json = self.browser_rpa.open_browser(
                url="http://babg-appweb-pre.oss-cn-hangzhou-yzwsouth-d01-a.res.zgf.yzwsouth.com/babgpt/index.html#/home",
                executable_path=executable_path,
                browser_path=browser_path,
                download_dir=self.g_dict["ls_dir"],
                run_log=True,
            )
            self.driver = obj_json['driver']
            logging.info(self.driver)
            self.driver.maximize_window()
            action = ActionChains(driver=self.driver)

            # self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
            #                                         value='//*[text()="下载前询问每个文件的保存位置"]')
            time.sleep(0.5)

            # 登录一张网系统
            # # 打开系统网址
            # self.driver.get(
            #     "http://babg-appweb-pre.oss-cn-hangzhou-yzwsouth-d01-a.res.zgf.yzwsouth.com/babgpt/index.html#/home")

            # 输入账号、密码
            self.button_rpa.enter_in_target(driver=self.driver, by=By.XPATH,
                                            value="//*[@placeholder='用户名/手机号/身份证']",
                                            text=self.g_dict["login_acc"])
            self.button_rpa.enter_in_target(driver=self.driver, by=By.XPATH,
                                            value="//*[@type='password']",
                                            text=self.g_dict["login_pw"])
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH, value="//*[@type='button']")
            # 等待系统登录完成
            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH, value="//aside/div/div[2]/*")
            time.sleep(2)
            # 点击费款管理-----------------
            # self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH, value="/html/body/div/section/section/section/main/div/div/div[2]/div[1]/div/div/div[2]/div[1]/div/div/div/div/div[1]/div/div")
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                         value="//div[contains(text(),'费款管理')]")

            #切换费款管理页面
            self.logger.info(self.driver.window_handles)
            self.driver.switch_to.window(self.driver.window_handles[1])
            # 等待费款管理页面出现-----------------
            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH,
                                       value='//*[@id="pane-/xnzhgl"]/div/div[2]/slot/div/button[1]/span')
            time.sleep(1.5)
            # 点击案款处理模块-------------------
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                         value='//*[@id="app"]/section/section/aside/div/div/div[1]/div/ul/li[2]/div/span')


            time.sleep(1)
            # 点击出账处理-------------------
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                         value='//*[@id="app"]/section/section/aside/div/div/div[1]/div/ul/li[2]/ul/li[3]/ul/li')

            # 清空案号
            input_element = self.driver.find_element(By.XPATH,"//input[@placeholder='年号']")
            input_element.clear()
            input_element.send_keys(" ")
            input_element.send_keys(Keys.BACKSPACE)
            input_element.send_keys("" + Keys.ENTER)
            time.sleep(1)
            #点击款项类别
            dropdown = self.driver.find_element(By.XPATH,value='//*[@id="pane-/czcl"]/div/div/div/div[1]/div[2]/div[1]/div[2]/div/div[1]/input')
            dropdown.click()
            time.sleep(2)
            option = self.driver.find_element(By.XPATH,value="//body/div/div/div/ul/li/span[text()='执行、调解款发放']")
            option.click()
            time.sleep(1)
            # 点击查询
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                         value="//*[text()='查询']")
            time.sleep(2)
            # 点击页数 选200页
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                         value='//*[@id="pane-/czcl"]/div/div/div/div[2]/span[2]/div/div/input')
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                         value='/html/body/div[3]/div[1]/div[1]/ul/li[4]/span')
            time.sleep(5)
            # 导出Excel存放到「保存路径」目录下
            excel_file = os.path.join(self.g_dict.get("save_dir", r"D:/机器人相关"), "案号提取.xlsx")
            g_log.info("[路径] Excel导出路径: %s", excel_file)
            case_number = self.extract_all_pages_case_numbers(excel_file)
            if case_number:
                g_log.info("成功提取案号")
            else:
                g_log.info("提取失败")
            #读取保存的excel
            time.sleep(10)
            case_list = self.read_cases_from_excel(excel_file)
            df = pd.read_excel(excel_file)
            do_once = False
            if case_list:
                for case in case_list:
                    app_no = case['申请单号']
                    g_log.info(app_no)
                    if case['状态'] == '已完成' or case['状态'] == '审批单已移送' or case['状态'] == '没有查询到数据':
                        g_log.info(f'跳过：{app_no}')
                        continue
                   #点击高级查询---------------------搜索申请单号
                    try:
                        self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                     value='//button/span[contains(text(),"高级查询")]')
                        self.page_rpa.wait_element(driver=self.driver, by=By.XPATH,
                                                   value="//*[contains(text(),'申请单号')]/following-sibling::*/input")
                        time.sleep(1)
                        # 申请单号
                        self.button_rpa.enter_in_target(driver=self.driver, by=By.XPATH,
                                                        value='//*[contains(text(),"申请单号")]/following-sibling::*/input',
                                                        text=app_no)
                        time.sleep(0.5)
                        # 点击查询
                        query_button_xpath = '(//*[text()="查询"])[2]'
                        self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                     value=query_button_xpath)
                        rows=[]
                        try:
                            time.sleep(1.5)
                            rows_xpath = "//*[@class='el-table__row']//span[contains(text(),'粤')]"
                            rows = self.find_rows_with_retry(rows_xpath, query_button_xpath, max_retries=3)
                            g_log.info(f"共查询到{len(rows)}条数据")
                        except Exception as e:
                            g_log.info(f"写入异常状态失败，跳过: {e}")
                            self.update_status_to_excel(excel_file, app_no, "审批单已移送", row_number=case['行号'])
                            continue


                        if len(rows) ==0:
                            try:
                                self.update_status_to_excel(excel_file, app_no, "审批单已移送", row_number=case['行号'])
                            except Exception as e:
                                g_log.info(f"写入数据异常，跳过: {e}")
                                continue

                    except Exception as e:
                        g_log.info(f"查询申请单号{app_no}失败: {e}")
                        try:
                            self.update_status_to_excel(excel_file, app_no, "异常", row_number=case['行号'])
                            self._safe_close_tab()
                        except Exception:
                            g_log.info(f"写入异常状态失败", exc_info=True)
                            self.driver_quit()
                        continue

                    # 逐条打印：按案号实时定位「操作」按钮，避免表格在打印后刷新/重排，
                    # 导致全局 idx 错位（第 2 条及以后点击超时、整条记录漏打）。
                    # 先一次性取出各条案号文本（避免循环中后期元素变 stale 导致异常），
                    # 每次点击都按案号重新查询 DOM 定位当前行。
                    try:
                        an_hao_list = [(r.text or "").strip() for r in rows if (r.text or "").strip()]
                    except Exception:
                        an_hao_list = [(r.text or "").strip() for r in rows]
                    total_rows = len(an_hao_list)
                    case_print_failed = False  # 本单是否有记录打印失败
                    for index, an_hao in enumerate(an_hao_list):
                        g_log.info(f"正在打印第{index + 1}/{total_rows}条数据，案号：{an_hao}")
                        # 通过案号锁定当前行，再找该行内的「操作」按钮（每次点击都重新查询 DOM）
                        op_xpath = (
                            "//*[@class='el-table__row'][.//span[contains(normalize-space(.), '"
                            + an_hao
                            + "')]]//span[text()='操作']"
                        )
                        for close in range(3):
                            #点击操作（按案号精确定位当前行，不依赖全局序号）
                            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                          value=op_xpath)
                            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH,
                                                       value="//*[text()='打印审批单']")
                            time.sleep(2)
                            #调用弹窗参数
                            g_log.info({type(self.driver)})
                            g_log.info(f"{self.driver}")
                            modal_selector = "body > div.el-dialog__wrapper > div"
                            self.handle_modal_dialog(modal_selector)
                            time.sleep(8)
                            windows = self.driver.window_handles
                            g_log.info(f"当前窗口数量：{len(windows)}")
                            if len(windows) < 2:
                                try:
                                    # 点击关闭出账信息窗口
                                    self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                                 value="//*[text()='出账信息']/following-sibling::*")
                                    # self.update_status_to_excel(excel_file, app_no, "审批单生成失败", row_number=case['行号'])
                                except Exception:
                                    g_log.info(f"点击关闭出账信息窗口异常", exc_info=True)
                                    pass
                                continue
                            else:
                                break

                        windows = self.driver.window_handles
                        g_log.info(f"当前窗口数量：{len(windows)}")
                        if len(windows) > 2:
                            self.driver.switch_to.window(windows[2])
                            g_log.info("已切换到第三个窗口")
                        else:
                            g_log.info(f"没有第三个窗口，当前只有{len(windows)}个窗口")
                        time.sleep(8)
                        # 刷新预览页，确保打印控件已加载（与“可以打印版”一致，避免预览空白导致漏打）
                        try:
                            self.driver.refresh()
                        except Exception:
                            g_log.info("刷新预览页失败，继续执行")
                        time.sleep(4)
                        g_log.info("-------------------------点击打印")
                        #点击打印
                        try:
                            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                         value='//*[@id="print"]')
                            g_log.info("-------------------------点击打印按钮成功")
                        except Exception as e:
                            g_log.info(f"点击打印按钮失败: {e}")
                            case_print_failed = True
                            try:
                                self.update_status_to_excel(excel_file, app_no, "打印失败", row_number=case['行号'])
                            except Exception:
                                g_log.info(f"写入打印失败状态异常", exc_info=True)
                                continue
                        time.sleep(2)
                        print_success, do_once = self.confirm_print_preview(do_once)
                        if not print_success:
                            case_print_failed = True
                            try:
                                self.update_status_to_excel(excel_file, app_no, "打印失败", row_number=case['行号'])
                            except Exception:
                                g_log.info(f"写入打印失败状态异常", exc_info=True)
                            continue

                        time.sleep(2)
                        self._clean_extra_tabs(keep=2)
                        time.sleep(2)
                        self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                                 value='/html/body/div[*]/div/div[1]/button')
                        time.sleep(2)

                    # 整单所有费款记录处理完成后才标记「已完成」：
                    # 避免打完第 1 条就写「已完成」，一旦中断重跑时整单被跳过、剩余记录漏打
                    if not case_print_failed:
                        try:
                            self.update_status_to_excel(excel_file, app_no, "已完成", row_number=case['行号'])
                            g_log.info(f"申请单号{app_no}全部{total_rows}条记录打印完成")
                        except Exception:
                            g_log.info(f"写入已完成状态异常", exc_info=True)


        except Exception as e:
            self.g_dict["err"] = True
            g_log.exception("业务初始化(yw_csh)异常 [%s]: %s", type(e).__name__, e)
            traceback.print_exc()

    def yw_cl(self):
        try:
            # 开始循环写入数据

            time.sleep(3.5)
        except Exception as e:
            self.g_dict["err"] = True
            g_log.exception("业务处理(yw_cl)异常 [%s]: %s", type(e).__name__, e)
            traceback.print_exc()

    def run_business(self):
        """实现具体的业务逻辑 - 完全使用aibot_common的浏览器操作组件"""
        try:
            g_log.info("开始执行业务逻辑...")
            # self.config.set_config("base_url", "http://www.qq.com")
            # self.init_browser()
            g_log.info("重试次数：%d", get_retry_count())
            g_log.info("业务逻辑执行中----")
            self.g_dict["err"] = False
            # 使用配置字典 读取参数
            g_log.info("---------------初始化开始")
            self.csh()
            g_log.info("---------------初始化结束")
            g_log.info("---------------业务初始化开始")
            self.yw_csh()
            g_log.info("---------------业务初始化开始结束")
            g_log.info("---------------业务处理开始")
            self.yw_cl()
            g_log.info("---------------业务处理结束")
            # 关闭谷歌浏览器
            # self.driver.close()
            time.sleep(1)
            self.logger.info("流程执行完毕")
            # 移除直接调用driver.quit()，避免与finally块中的driver_quit()重复
            # shutil.rmtree(self.g_dict["ls_dir"])
            if self.g_dict["err"]:
                raise Exception("存在异常，进入重试")

            g_log.info("业务逻辑执行完成")

            return True
        except Exception as e:
            g_log.exception(f"业务逻辑执行异常: {e}")
            return False
        finally:
            # 使用self.browser_rpa关闭浏览器
            try:
                g_log.info("使用self.browser_rpa关闭浏览器...")
                try:
                    shutil.rmtree(self.g_dict["ls_dir"])
                except Exception as e:
                    pass
                self.browser_rpa.close_browser()
            except Exception as e:
                g_log.warning(f"关闭浏览器时出错: {e}")
                # 降级使用原有的关闭方式
                self.driver_quit()


def main():
    """主函数"""
    from aibot_rpa.config.manager import ConfigManager

    exit_code = 0
    flow = None

    try:
        g_log.info("=== 程序启动 ===")

        # 1. 初始化配置管理器
        config_manager = ConfigManager()

        # 2. 加载配置
        config_template = {
            "taskId": "minimal_demo_001",
            "name": "费款打印",
            # 路径原则：平台/控制台配置下发优先；缺省走 D 盘安装位置，不再锁定 C 盘
            "max_retries": 100,
            "retry_delay": 2,
            "timeout": 30,
            "record_video": True,
            "live_push": True,
            "headless": False,
            "start_time": "2025-11-20",
            "AuthCode": "2TR5gFSPA3DCbj374poHt",
            # "loginPW": r"040425a!",
            # "loginAcc": r"18000850165",
            "loginPW": r"315helen!",
            "loginAcc": r"18000850608",
            "isPW":None,
            "end_time": "2025-11-25",
            "uniTable": [["rlXGyHEa17kZIaVg1wUgw", "费款打印"]],
            "保存路径": "D:/机器人相关",
            "executable_path": r"D:/module/driver/86/chromedriver.exe",
            "browser_path": r"D:/app/360Chrome/Chrome/Application/360chrome.exe"
            # "base_url": "http://www.baidu.com",
        }
        s = config_template["loginPW"]
        if s.startswith('0') and s.isdigit():
            config_template['isPW'] = True

        # ==================== 运行路径准备（不迁移/不锁死 C 盘） ====================
        # config_template 已含缺省 executable/browser（平台下发优先），无需再做盘符改写
        g_log.info("[路径] 保存路径: %s", config_template.get("保存路径"))
        g_log.info("[路径] executable_path: %s", config_template.get("executable_path"))
        g_log.info("[路径] browser_path: %s", config_template.get("browser_path"))

        # 2. 加载配置（控制台没有就用config_template）
        config_manager.load_config_args(config_template)

        # 加载自定义配置（不再做任何 C 盘标准化改写）
        custom_config = {
            "executable_path": config_template.get("executable_path") or r"D:/module/driver/86/chromedriver.exe",
            "browser_path": config_template.get("browser_path") or r"D:/app/360Chrome/Chrome/Application/360chrome.exe",
            "record_fps": 10,
            "record_video": True,
            "live_push": False
        }
        config_manager.load_dict(custom_config)

        g_log.info(f"配置加载完成: {config_manager.get_config('name', 'Unknown')}")

        # 3. 执行流程
        g_log.info("开始执行RPA流程...")
        flow = MinimalRPAFlow(config_manager=config_manager)
        result = flow.execute()

        if result:
            g_log.info("✅ RPA流程执行成功！")
            g_log.info({"msg": "已完成"})
            exit_code = 0
        else:
            g_log.error("❌ RPA流程执行失败！")
            g_log.info({"error": "运行异常"})
            exit_code = 1

    except KeyboardInterrupt:
        g_log.warning("⚠️ 用户中断程序执行")
        exit_code = 2

    except Exception as e:
        g_log.exception(f"💥 程序执行异常: {e}")
        exit_code = 1

    finally:
        # 确保关闭浏览器
        try:
            if flow and hasattr(flow, 'driver') and flow.driver:
                flow.driver_quit()
                g_log.info("浏览器已关闭")
        except Exception as e:
            g_log.warning(f"关闭浏览器时出错: {e}")
        g_log.info("=== 程序结束 ===")

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
