# ================================ 全局变量初始化 ================================
g_log = LoggerInit.init(__name__)


class MinimalRPAFlow(BaseFlow):
    """极简RPA流程类 - 使用aibot_common"""

    def __init__(self, config_manager=None, **kwargs):
        super().__init__(config_manager=config_manager, **kwargs)
        # 使用预导入的BROWSER_RPA实例
        self.browser_rpa = BROWSER_RPA
        self.button_rpa = BUTTON_RPA
        self.page_rpa = PAGE_RPA
        self.mouse_rpa = MOUSE_RPA
        self.config_manager = config_manager
        self.other_rpa = OTHER_RPA
        self.get_data_rpa = GETDATA_RPA
        self.g_dict = {}
        self.main_window_handle = None

    def start_data(self, table_id, auth_code):  # 初始化异常数据
        print("--------------数据初始化")
        payload = {
            "uniId": table_id,
            "pageSize": 1,
            "reqParam": {
                "queryParam": [
                    {
                        "field": "zt",
                        "value": [
                            "处理中"
                        ],
                        "sign": "=",
                        "append": "or"
                    }, {
                        "field": "zt",
                        "value": [
                            "异常"
                        ],
                        "sign": "=",
                        "append": "or"
                    }
                ],
                "updateMap": {
                    "zt": "",

                }
            }
        }
        while True:
            rqs_data = self.other_rpa.post_request(
                url="http://146.24.58.227:88/ymkj-api/uni/universal/pull",
                payload=payload,
                auth_token=f'AuthCode {auth_code}')
            print(rqs_data)
            data = rqs_data['data']['list']
            if len(data) == 0:  # 判断是否还有数据需要操作
                break

    def csh(self):
        try:
            # 使用配置字典 读取参数
            config_dict = self.config_manager.get_dict_config()
            self.g_dict["config_dict"] = config_dict
            
            if not config_dict:
                g_log.warning("配置字典为空，使用默认配置")
                config_dict = {}
            
            # 获取AuthCode，确保配置正确传递
            self.g_dict["auth_code"] = self._get_config_value(config_dict, "AuthCode", required=True)
            g_log.info(f"获取到AuthCode: {self.g_dict['auth_code'][:6]}...")
            
            # 获取table_id
            uni_table = self._get_config_value(config_dict, "uniTable", default=[["", ""]])
            self.g_dict["table_id"] = uni_table[0][0] if uni_table and len(uni_table) > 0 else ""
            g_log.info(f"获取到table_id: {self.g_dict['table_id']}")
            
            # 获取登录账号
            self.g_dict["login_acc"] = str(self._get_config_value(config_dict, "loginAcc", required=True))
            g_log.info(f"获取到登录账号: {self.g_dict['login_acc']}")
            
            # 获取登录密码
            login_pw = self._get_config_value(config_dict, "loginPW", required=True)
            is_pw = self._get_config_value(config_dict, "isPW", default=False)
            if is_pw:
                self.g_dict["login_pw"] = "0" + str(login_pw)
            else:
                self.g_dict["login_pw"] = str(login_pw)
            g_log.info(f"获取到登录密码: ******")

            # 获取时间范围配置
            self.g_dict["start_time"] = self._get_config_value(config_dict, "start_time", default="")
            self.g_dict["end_time"] = self._get_config_value(config_dict, "end_time", default="")
            g_log.info(f"获取到时间范围: {self.g_dict['start_time']} 至 {self.g_dict['end_time']}")
            
            # 设置默认时间（如果未配置）
            if self.g_dict["start_time"] == "" and self.g_dict["end_time"] == "":
                new_data = datetime.datetime.now() - datetime.timedelta(days=1)
                new_data_str = new_data.strftime("%Y-%m-%d")
                self.g_dict["start_time"] = new_data_str
                self.g_dict["end_time"] = new_data_str
                g_log.info(f"未配置时间范围，使用默认值: {new_data_str}")
            else:
                if self.g_dict["start_time"] == "":
                    self.g_dict["start_time"] = self.g_dict["end_time"]
                elif self.g_dict["end_time"] == "":
                    self.g_dict["end_time"] = self.g_dict["start_time"]
            
            # 获取保存路径
            self.g_dict["save_dir"] = self._get_config_value(config_dict, "保存路径", default="D:/module/driver/86")
            if not os.path.isdir(self.g_dict["save_dir"]):
                os.makedirs(self.g_dict["save_dir"])
                g_log.info(f"创建保存目录: {self.g_dict['save_dir']}")
            
            self.g_dict["new_data"] = self.g_dict["start_time"] + "至" + self.g_dict["end_time"]
            self.g_dict["save_path"] = self.g_dict["save_dir"] + r"/法官助理" + self.g_dict["new_data"] + ".xlsx"
            
            # 创建临时下载目录
            ls_id = random.randint(1, 1000000)
            self.g_dict["ls_dir"] = f"D:/临时下载/{ls_id}"
            if not os.path.isdir(self.g_dict["ls_dir"]):
                os.makedirs(self.g_dict["ls_dir"])
            g_log.info(f"创建临时下载目录: {self.g_dict['ls_dir']}")
            
            g_log.info("配置初始化完成")
            
        except Exception as e:
            self.g_dict["err"] = True
            g_log.error(f"配置初始化失败: {e}")
            traceback.print_exc()
    
    def _get_config_value(self, config_dict, key, default=None, required=False):
        """
        安全获取配置值
        :param config_dict: 配置字典
        :param key: 配置键
        :param default: 默认值
        :param required: 是否必填
        :return: 配置值
        """
        if key in config_dict:
            value = config_dict[key]
            if value is not None:
                return value
        
        if required:
            g_log.error(f"缺少必填配置项: {key}")
            raise ValueError(f"缺少必填配置项: {key}")
        
        g_log.warning(f"配置项 {key} 未设置，使用默认值: {default}")
        return default

    def yw_csh(self):
        try:
            # 打开浏览器 - set driver first
            # 从配置获取浏览器相关路径
            executable_path = self.config_manager.get_config('executable_path', r'D:/module/driver/86/chromedriver.exe')
            browser_path = self.config_manager.get_config('browser_path', r'D:/app/360Chrome/Chrome/Application/360chrome.exe')
            g_log.info(f"配置的浏览器驱动路径: {executable_path}")
            g_log.info(f"配置的浏览器路径: {browser_path}")

            # 检查路径是否存在
            if executable_path and os.path.exists(executable_path):
                g_log.info(f"驱动路径存在: {executable_path}")
            else:
                g_log.warning(f"驱动路径不存在或未配置: {executable_path}")
            
            if browser_path and os.path.exists(browser_path):
                g_log.info(f"浏览器路径存在: {browser_path}")
            else:
                g_log.warning(f"浏览器路径不存在或未配置: {browser_path}")

            obj_json = self.browser_rpa.open_browser(
                url="http://babg-appweb-pre.oss-cn-hangzhou-yzwsouth-d01-a.res.zgf.yzwsouth.com/babgpt/index.html#/home",
                executable_path=executable_path,
                browser_path=browser_path,
                download_dir=self.g_dict["ls_dir"],
                run_log=True,
            )
            self.driver = obj_json['driver']
            g_log.info(f"浏览器初始化成功: {self.driver}")
            
            try:
                self.driver.maximize_window()
                g_log.info("窗口最大化成功")
            except Exception as e:
                g_log.warning(f"窗口最大化失败: {e}")
            
            # 保存主窗口句柄
            self.main_window_handle = self.driver.current_window_handle
            g_log.info(f"主窗口句柄: {self.main_window_handle}")

            time.sleep(0.5)

            # 登录一张网系统
            # # 打开系统网址
            # self.driver.get(
            #     "http://babg-appweb-pre.oss-cn-hangzhou-yzwsouth-d01-a.res.zgf.yzwsouth.com/babgpt/index.html#/home")
            # 输入账号、密码
            self.button_rpa.enter_in_target(driver=self.driver, by=By.XPATH,
                                            value="//*[@placeholder='用户名/手机号/身份证']",
                                            text=self.g_dict["login_acc"])
            self.button_rpa.enter_in_target(driver=self.driver, by=By.XPATH,
                                            value="//*[@type='password']",
                                            text=self.g_dict["login_pw"])
            # 等待登录按钮可见并可点击
            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH, value="//*[@id='pane-0']/form/div[4]/div/button", timeout=30)
            # self.page_rpa.wait_element(driver=self.driver, by=By.XPATH, value="//span[contains(normalize-space(text()),'登 录')]", timeout=30)
            time.sleep(1)
            # 尝试点击登录按钮，增加重试机制
            login_success = False
            for attempt in range(3):
                try:
                    self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH, 
                                                 value="//span[contains(normalize-space(text()),'登 录')]",
                                                 timeout=10)
                    login_success = True
                    break
                except Exception as e:
                    g_log.warning(f"登录按钮点击失败，尝试第 {attempt+1} 次: {e}")
                    time.sleep(1)
            
            if not login_success:
                g_log.error("登录按钮点击失败，尝试使用JavaScript点击")
                try:
                    # element = self.driver.find_element(By.XPATH, "//span[contains(normalize-space(text()),'登 录')]")
                    element = self.driver.find_element(By.XPATH, "//*[@id='pane-0']/form/div[4]/div/button/span")
                    self.driver.execute_script("arguments[0].click();", element)
                    login_success = True
                except Exception as e:
                    g_log.error(f"JavaScript点击也失败: {e}")
                    raise
            
            # 等待系统登录完成
            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH, value="//aside/div/div[2]/*", timeout=60)
            time.sleep(1)
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH, value="//aside/div/div[2]/*")
            # 等待我的案件出现
            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH,
                                       value='//span/*[text()="我的案件"]')
            time.sleep(0.5)
            self.mouse_rpa.click_element(driver=self.driver, by=By.XPATH,
                                         value='//span/*[text()="我的案件"]')
            # 等待数据加载完成
            self.page_rpa.wait_element(driver=self.driver, by=By.XPATH, value="//*[contains(text(),'粤')]")


        except Exception as e:
            self.g_dict["err"] = True
            logging.info(e)
            traceback.print_exc()

