# GPU 版 OCR 镜像 (仅 x86_64 Linux + NVIDIA)
# 宿主机只需装 NVIDIA 驱动 + nvidia-container-toolkit, CUDA 由镜像内提供
ARG PYTHON_TAG=3.10
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DEBIAN_FRONTEND=noninteractive TZ=Asia/Shanghai

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip libgl1 libglib2.0-0 libgomp1 \
        fonts-noto-cjk fonts-wqy-zenhei wget tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s python3 /usr/bin/python

WORKDIR /app
COPY requirements-common.txt requirements-paddle.txt ./
RUN pip install -r requirements-common.txt && pip install -r requirements-paddle.txt
COPY app/ ./app/
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
